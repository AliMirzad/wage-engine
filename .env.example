# این فایل را کپی کرده و به .env تغییر نام دهید، سپس مقادیر واقعی را پر کنید.
# .env نباید در git کامیت شود.

# ---------- PostgreSQL ----------
POSTGRES_DB=accounting_db
POSTGRES_USER=accounting_user
# استفاده از رمز قوی؛ در prod با ابزار secret manager تولید کنید.
POSTGRES_PASSWORD=

# ---------- JWT ----------
# باید Base64 با حداقل ۳۲ بایت باشد. تولید:
#   openssl rand -base64 48
JWT_SECRET=

# ---------- Super Admin (فقط برای اولین boot) ----------
# بعد از اولین ورود حتماً از پنل تغییر دهید.
SUPER_ADMIN_PASSWORD=

# ---------- CORS ----------
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=https://panel.example.com

# ---------- سطح لاگ ----------
LOG_LEVEL_APP=INFO
