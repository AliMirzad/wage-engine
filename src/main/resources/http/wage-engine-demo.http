Authorization: Bearer {{accToken}}

### 7.10 قراردادهای یک کارمند
GET {{baseUrl}}/employees/{{emp1Id}}/contracts
Authorization: Bearer {{accToken}}


### -------------------------------------------------------------------------
### فاز ۸ — چرخه حیات: خاتمه، زنجیره، ابطال
### -------------------------------------------------------------------------

### 8.1 حذف کارمندی که قرارداد فعال دارد — باید مسدود شود
# انتظار: 409 با فهرست شماره قراردادهای مانع
DELETE {{baseUrl}}/employees/{{emp1Id}}
Authorization: Bearer {{caToken}}

### 8.2 خاتمه قرارداد اول
# انتظار: 204
POST {{baseUrl}}/contracts/{{contract1Id}}/end
Authorization: Bearer {{accToken}}
Content-Type: application/json

{
  "endDate": "2026-09-22"
}

### 8.3 قرارداد جدید با زنجیره — افزایش حقوق
# انتظار: 201 — روش قانونی تغییر حقوق
POST {{baseUrl}}/contracts
Authorization: Bearer {{accToken}}
Content-Type: application/json

{
  "employeeId": {{emp1Id}},
  "projectId": {{projectId}},
  "contractType": "TEMPORARY",
  "salaryBasis": "MONTHLY",
  "baseSalary": "85000000",
  "housingAllowance": "9000000",
  "foodAllowance": "14000000",
  "childAllowanceBase": "3500000",
  "transportAllowance": "3500000",
  "seniorityPay": "2800000",
  "startDate": "2026-09-23",
  "endDate": "2027-03-20",
  "previousContractId": {{contract1Id}},
  "notes": "افزایش حقوق مطابق مصوبه شورای عالی کار"
}

> {%
    client.global.set("contract3Id", response.body.id);
    client.test("زنجیره برقرار شد", () =>
        client.assert(response.body.previousContractId !== null));
%}

### 8.4 زنجیره تکراری — باید مسدود شود
# انتظار: 409 — هر قرارداد حداکثر یک جانشین دارد
POST {{baseUrl}}/contracts
Authorization: Bearer {{accToken}}
Content-Type: application/json

{
  "employeeId": {{emp1Id}},
  "projectId": {{projectId}},
  "contractType": "TEMPORARY",
  "salaryBasis": "MONTHLY",
  "baseSalary": "90000000",
  "startDate": "2026-10-01",
  "endDate": "2027-03-20",
  "previousContractId": {{contract1Id}}
}

### 8.5 زنجیره به کارمند دیگر — باید مسدود شود
# انتظار: 400 با code = contract.previous.different_pair
POST {{baseUrl}}/contracts
Authorization: Bearer {{accToken}}
Content-Type: application/json

{
  "employeeId": {{emp2Id}},
  "projectId": {{projectId}},
  "contractType": "TEMPORARY",
  "salaryBasis": "DAILY",
  "baseSalary": "3000000",
  "startDate": "2027-01-01",
  "endDate": "2027-06-01",
  "previousContractId": {{contract1Id}}
}

### 8.6 ابطال قرارداد کارگر دوم
# انتظار: 204
POST {{baseUrl}}/contracts/{{contract2Id}}/void
Authorization: Bearer {{accToken}}
Content-Type: application/json

{
  "reason": "اشتباه در ثبت مبلغ دستمزد روزانه"
}

### 8.7 ابطال دوباره — باید مسدود شود
# انتظار: 400
POST {{baseUrl}}/contracts/{{contract2Id}}/void
Authorization: Bearer {{accToken}}
Content-Type: application/json

{
  "reason": "تکراری"
}


### -------------------------------------------------------------------------
### فاز ۹ — چرخه حیات کارمند
### -------------------------------------------------------------------------

### 9.1 غیرفعال‌سازی موقت کارگر دوم
# انتظار: 204
POST {{baseUrl}}/employees/{{emp2Id}}/deactivate
Authorization: Bearer {{accToken}}

### 9.2 فعال‌سازی مجدد
POST {{baseUrl}}/employees/{{emp2Id}}/reactivate
Authorization: Bearer {{accToken}}

### 9.3 ثبت ترک کار
# انتظار: 200 — قرارداد کارگر دوم باطل شده پس مانعی نیست
POST {{baseUrl}}/employees/{{emp2Id}}/terminate
Authorization: Bearer {{accToken}}
Content-Type: application/json

{
  "terminationDate": "2026-07-20",
  "terminationReason": "استعفا"
}

### 9.4 reactivate روی کارمند ترک‌کار‌کرده — باید مسدود شود
# انتظار: 409 با code = employee.terminated.use_rehire
POST {{baseUrl}}/employees/{{emp2Id}}/reactivate
Authorization: Bearer {{accToken}}

### 9.5 قرارداد برای کارمند ترک‌کار‌کرده — باید مسدود شود
# انتظار: 400
POST {{baseUrl}}/contracts
Authorization: Bearer {{accToken}}
Content-Type: application/json

{
  "employeeId": {{emp2Id}},
  "projectId": {{projectId}},
  "contractType": "TEMPORARY",
  "salaryBasis": "DAILY",
  "baseSalary": "2500000",
  "startDate": "2026-08-01",
  "endDate": "2026-12-01"
}

### 9.6 لیست پیش‌فرض — ترک‌کار‌کرده نباید باشد
GET {{baseUrl}}/employees
Authorization: Bearer {{accToken}}

### 9.7 لیست با ترک‌کار‌کرده‌ها
GET {{baseUrl}}/employees?includeTerminated=true
Authorization: Bearer {{accToken}}

### 9.8 استخدام مجدد
# انتظار: 200 — همان کد پرسنلی، تاریخ استخدام جدید
POST {{baseUrl}}/employees/{{emp2Id}}/rehire
Authorization: Bearer {{accToken}}
Content-Type: application/json

{
  "hireDate": "2026-07-26",
  "note": "بازگشت پس از تسویه"
}


### -------------------------------------------------------------------------
### فاز ۱۰ — جداسازی شرکت‌ها و مسیر نجات
### -------------------------------------------------------------------------

### 10.1 ثبت شرکت دوم
POST {{baseUrl}}/admin/tenants
Authorization: Bearer {{saToken}}
Content-Type: application/json

{
  "name": "شرکت راه‌سازی البرز",
  "code": "alborz",
  "adminUsername": "alborz.admin",
  "adminEmail": "admin@alborz.ir",
  "adminPassword": "Alborz@1404"
}

> {%
    client.global.set("tenant2Id", response.body.id);
%}

### 10.2 ورود مدیر شرکت دوم
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "usernameOrEmail": "alborz.admin",
  "password": "Alborz@1404"
}

> {%
    client.global.set("ca2Token", response.body.accessToken);
%}

### 10.3 مدیر شرکت دوم پروژه شرکت اول را ببیند — باید نبیند
# انتظار: 404 (نه 403) — از دید او این پروژه وجود ندارد
GET {{baseUrl}}/projects/{{projectId}}
Authorization: Bearer {{ca2Token}}

### 10.4 لیست پروژه‌های شرکت دوم — باید خالی باشد
GET {{baseUrl}}/projects
Authorization: Bearer {{ca2Token}}

> {%
    client.test("جداسازی شرکت‌ها", () =>
        client.assert(response.body.totalElements === 0,
            "شرکت دوم نباید پروژه‌ای ببیند"));
%}

### 10.5 لیست کاربران شرکت اول توسط SUPER_ADMIN
GET {{baseUrl}}/admin/tenants/{{tenantId}}/users
Authorization: Bearer {{saToken}}

### 10.6 بازنشانی رمز مدیر شرکت توسط SUPER_ADMIN
# انتظار: 200 + رمز جدید — مسیر نجات وقتی مدیر رمزش را گم کرده
POST {{baseUrl}}/admin/tenants/{{tenantId}}/users/{{accUserId}}/reset-password
Authorization: Bearer {{saToken}}

### 10.7 ارتقای حسابدار به مدیر شرکت
# انتظار: 200 — وقتی مدیر قبلی رفته است
POST {{baseUrl}}/admin/tenants/{{tenantId}}/users/{{accUserId}}/grant-company-admin
Authorization: Bearer {{saToken}}


