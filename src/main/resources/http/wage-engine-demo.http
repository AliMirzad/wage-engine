Authorization: Bearer {{accToken}}
Content-Type: application/json

{
  "currentPassword": "{{accPassword}}",
  "newPassword": "Zahra@1404"
}

### 4.8 ورود مجدد با رمز جدید
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "usernameOrEmail": "arman.hesabdar",
  "password": "Zahra@1404"
}

> {%
    client.global.set("accToken", response.body.accessToken);
%}


### -------------------------------------------------------------------------
### فاز ۵ — پروژه
### -------------------------------------------------------------------------

### 5.1 ساخت پروژه
# انتظار: 201، وضعیت ACTIVE، contractAmount پر (حسابدار نیست، مدیر است)
POST {{baseUrl}}/projects
Authorization: Bearer {{caToken}}
Content-Type: application/json

{
  "name": "مجتمع مسکونی نارون",
  "code": "P-001",
  "description": "احداث ۴۰ واحد مسکونی در سه بلوک",
  "startDate": "2026-03-21",
  "endDate": "2027-09-22",
  "clientName": "شرکت عمران گستر پارس",
  "clientNationalId": "10987654321",
  "clientContractNumber": "PMN-1404-88",
  "clientContractDate": "2026-03-10",
  "contractAmount": "125000000000",
  "location": "تهران، شهرک غرب"
}

> {%
    client.global.set("projectId", response.body.id);
    client.test("پروژه ساخته شد", () => client.assert(response.status === 201));
    client.test("وضعیت ACTIVE", () => client.assert(response.body.status === "ACTIVE"));
    client.test("مدیر مبلغ پیمان را می‌بیند", () =>
        client.assert(response.body.contractAmount !== null));
%}

### 5.2 پروژه دوم
POST {{baseUrl}}/projects
Authorization: Bearer {{caToken}}
Content-Type: application/json

{
  "name": "بازسازی ساختمان اداری مرکزی",
  "code": "P-002",
  "startDate": "2026-05-01",
  "clientName": "بانک صادرات",
  "location": "تهران، میدان آرژانتین"
}

> {%
    client.global.set("project2Id", response.body.id);
%}

### 5.3 حسابدار پروژه را می‌بیند — ولی نه مبلغ پیمان
# انتظار: 200 با contractAmount = null
GET {{baseUrl}}/projects/{{projectId}}
Authorization: Bearer {{accToken}}

> {%
    client.test("حسابدار مبلغ پیمان را نمی‌بیند", () =>
        client.assert(response.body.contractAmount === null,
            "PROJECT_FINANCIAL_READ نباید برای ACCOUNTANT باشد"));
%}

