### فاز ۷ — قراردادها
### -------------------------------------------------------------------------

### 7.1 قرارداد اول — علی روی پروژه یک
# انتظار: 201، contractNumber خودکار CT-{tenantId}-0001
POST {{baseUrl}}/contracts
Authorization: Bearer {{accToken}}
Content-Type: application/json

{
  "employeeId": {{emp1Id}},
  "projectId": {{projectId}},
  "contractType": "TEMPORARY",
  "salaryBasis": "MONTHLY",
  "baseSalary": "71000000",
  "housingAllowance": "9000000",
  "foodAllowance": "14000000",
  "childAllowanceBase": "3500000",
  "transportAllowance": "3000000",
  "seniorityPay": "2100000",
  "hardshipAllowance": "0",
  "workingHoursPerWeek": "44",
  "startDate": "2026-03-21",
  "endDate": "2027-03-20",
  "signedDate": "2026-03-15",
  "jobTitle": "جوشکار درجه ۲"
}

> {%
    client.global.set("contract1Id", response.body.id);
    client.global.set("contract1No", response.body.contractNumber);
    client.test("قرارداد ساخته شد", () => client.assert(response.status === 201));
    client.test("فعال است", () => client.assert(response.body.active === true));
    client.test("مجموع مزایا محاسبه شد", () =>
        client.assert(response.body.totalFixedAllowances !== null));
%}

