### =========================================================================
###  سامانه دستمزد مناز — فلوی کامل دمو
###
###  ترتیب اجرا مهم است. هر بلاک را جداگانه اجرا کنید (دکمه سبز کنار ###).
###  «Run All» توصیه نمی‌شود — IntelliJ متغیرها را زودهنگام ارزیابی می‌کند
###  و بلاک‌های بعدی مقدار کهنه می‌بینند (Deferred #20).
###
###  پیش‌نیاز: دیتابیس تازه (V1 اجرا شده) و اپ در حال اجرا روی 8080.
### =========================================================================

@baseUrl = http://localhost:8080/api/v1
@adminUser = admin
@adminPass = ChangeMe@123

### -------------------------------------------------------------------------
### فاز ۱ — ورود مدیر پلتفرم
### -------------------------------------------------------------------------

### 1.1 ورود SUPER_ADMIN
# انتظار: 200، لیست permissions باید ۳۰ مورد باشد (شامل PROJECT_FINANCIAL_READ)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "usernameOrEmail": "{{adminUser}}",
  "password": "{{adminPass}}"
}

> {%
    client.global.set("saToken", response.body.accessToken);
    client.global.set("saRefresh", response.body.refreshToken);
    client.test("ورود موفق", () => client.assert(response.status === 200));
    client.test("SUPER_ADMIN همه دسترسی‌ها را دارد", () =>
        client.assert(response.body.user.permissions.length >= 30,
            "تعداد دسترسی: " + response.body.user.permissions.length));
%}

### 1.2 بررسی حساسیت به بزرگی حروف
# انتظار: 200 — ADMIN با admin یکی است
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "usernameOrEmail": "ADMIN",
  "password": "{{adminPass}}"
}

### 1.3 رمز اشتباه
# انتظار: 401 با code = auth.invalid_credentials
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "usernameOrEmail": "{{adminUser}}",
  "password": "WrongPassword@1"
}

### 1.4 پروفایل کاربر جاری
# انتظار: 200، tenantId = null، ۳۰ دسترسی
GET {{baseUrl}}/auth/me
Authorization: Bearer {{saToken}}


### -------------------------------------------------------------------------
### فاز ۲ — ثبت شرکت مشتری
### -------------------------------------------------------------------------

### 2.1 ثبت شرکت + اولین مدیر
# انتظار: 201، شرکت و کاربر COMPANY_ADMIN در یک تراکنش
POST {{baseUrl}}/admin/tenants
Authorization: Bearer {{saToken}}
Content-Type: application/json

{
  "name": "شرکت ساختمانی آرمان بنا",
  "code": "arman",
  "nationalId": "10101234567",
  "insuranceWorkshopCode": "9876543210",
  "economicCode": "411111111111",
  "iban": "IR820540102680020817909002",
  "address": "تهران، خیابان ولیعصر، پلاک ۱۲۰",
  "phone": "02188776655",
  "adminUsername": "arman.admin",
  "adminEmail": "admin@armanbana.ir",
  "adminPassword": "Arman@1404",
  "adminFirstName": "رضا",
  "adminLastName": "کاظمی"
}

> {%
    client.global.set("tenantId", response.body.id);
    client.test("شرکت ساخته شد", () => client.assert(response.status === 201));
    client.test("شرکت فعال است", () => client.assert(response.body.active === true,
        "اگر false است یعنی @Builder.Default روی Tenant.active جا افتاده"));
%}

### 2.2 کد شرکت تکراری
# انتظار: 409 با code = tenant.code.duplicate
POST {{baseUrl}}/admin/tenants
Authorization: Bearer {{saToken}}
Content-Type: application/json

{
  "name": "شرکت دیگر",
  "code": "arman",
  "adminUsername": "other.admin",
  "adminEmail": "other@example.com",
  "adminPassword": "Other@1404"
}

### 2.3 نام کاربری تکراری (یکتایی سراسری)
# انتظار: 409 با code = user.username.duplicate
POST {{baseUrl}}/admin/tenants
Authorization: Bearer {{saToken}}
Content-Type: application/json

{
  "name": "شرکت سوم",
  "code": "third",
  "adminUsername": "arman.admin",
  "adminEmail": "third@example.com",
  "adminPassword": "Third@1404"
}

### 2.4 لیست شرکت‌ها
GET {{baseUrl}}/admin/tenants
Authorization: Bearer {{saToken}}


### -------------------------------------------------------------------------
### فاز ۳ — ورود مدیر شرکت و تکمیل اطلاعات
### -------------------------------------------------------------------------

### 3.1 ورود مدیر شرکت
# انتظار: 200، tenantId برابر شناسه شرکت، نقش COMPANY_ADMIN
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "usernameOrEmail": "arman.admin",
  "password": "Arman@1404"
}

> {%
    client.global.set("caToken", response.body.accessToken);
    client.test("ورود مدیر شرکت", () => client.assert(response.status === 200));
    client.test("به شرکت متصل است", () =>
        client.assert(response.body.user.tenantId !== null));
    client.test("ROLE_WRITE ندارد", () =>
        client.assert(!response.body.user.permissions.includes("ROLE_WRITE"),
            "V9 باید ROLE_WRITE را از COMPANY_ADMIN گرفته باشد"));
%}

### 3.2 مشاهده اطلاعات شرکت خودم
# انتظار: 200، همان اطلاعاتی که در 2.1 ثبت شد
GET {{baseUrl}}/my-company
Authorization: Bearer {{caToken}}

### 3.3 ویرایش اطلاعات شرکت
# انتظار: 200 — فقط فیلدهای ارسالی عوض می‌شوند
PUT {{baseUrl}}/my-company
Authorization: Bearer {{caToken}}
Content-Type: application/json

{
  "phone": "02188776600",
  "address": "تهران، سعادت‌آباد، بلوار دریا، پلاک ۴۵"
}

### 3.4 شبای نامعتبر
# انتظار: 400
PUT {{baseUrl}}/my-company
Authorization: Bearer {{caToken}}
Content-Type: application/json

{
  "iban": "IR123"
}

### 3.5 SUPER_ADMIN روی my-company
# انتظار: 400 با code = tenant.tenant_required (چون tenantId = null دارد)
GET {{baseUrl}}/my-company
Authorization: Bearer {{saToken}}


### -------------------------------------------------------------------------
### فاز ۴ — ساخت حسابدار
### -------------------------------------------------------------------------

### 4.1 ساخت کاربر حسابدار
# انتظار: 201 + initialPassword — این رمز فقط همین یک بار برمی‌گردد
POST {{baseUrl}}/users
Authorization: Bearer {{caToken}}
Content-Type: application/json

{
  "username": "arman.hesabdar",
  "email": "hesabdar@armanbana.ir",
  "firstName": "زهرا",
  "lastName": "کریمی",
  "roleNames": ["ACCOUNTANT"]
}

> {%
    client.global.set("accPassword", response.body.initialPassword);
    client.global.set("accUserId", response.body.user.id);
    client.test("حسابدار ساخته شد", () => client.assert(response.status === 201));
    client.test("رمز اولیه برگشت", () =>
        client.assert(response.body.initialPassword &&
                      response.body.initialPassword.length === 8));
%}

### 4.2 تلاش برای ساخت SUPER_ADMIN — باید مسدود شود
# انتظار: 400 با code = user.role.not_assignable
POST {{baseUrl}}/users
Authorization: Bearer {{caToken}}
Content-Type: application/json

{
  "username": "evil.user",
  "email": "evil@armanbana.ir",
  "roleNames": ["SUPER_ADMIN"]
}

### 4.3 تلاش برای ساخت COMPANY_ADMIN دوم — باید مسدود شود
# انتظار: 400 — مدیر شرکت نمی‌تواند مدیر دیگری بسازد
POST {{baseUrl}}/users
Authorization: Bearer {{caToken}}
Content-Type: application/json

{
  "username": "second.admin",
  "email": "second@armanbana.ir",
  "roleNames": ["COMPANY_ADMIN"]
}

### 4.4 لیست کاربران شرکت
# انتظار: 200 — دو کاربر (مدیر و حسابدار)
GET {{baseUrl}}/users
Authorization: Bearer {{caToken}}

### 4.5 ورود حسابدار با رمز اولیه
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "usernameOrEmail": "arman.hesabdar",
  "password": "{{accPassword}}"
}

> {%
    client.global.set("accToken", response.body.accessToken);
    client.test("ورود حسابدار", () => client.assert(response.status === 200));
    client.test("USER_WRITE ندارد", () =>
        client.assert(!response.body.user.permissions.includes("USER_WRITE")));
%}

### 4.6 حسابدار لیست کاربران را ببیند — باید مسدود شود
# انتظار: 403
GET {{baseUrl}}/users
Authorization: Bearer {{accToken}}

### 4.7 تغییر رمز اولیه توسط حسابدار
