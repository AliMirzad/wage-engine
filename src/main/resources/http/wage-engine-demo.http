### 6.1 ثبت کارگر اول
# انتظار: 201، personnelCode خودکار EMP-{tenantId}-0001
POST {{baseUrl}}/employees
Authorization: Bearer {{accToken}}
Content-Type: application/json

{
  "firstName": "علی",
  "lastName": "محمدی",
  "nationalId": "0084575948",
  "birthDate": "1991-08-03",
  "hireDate": "2026-03-21",
  "phoneNumber": "09121234567",
  "childrenCount": 2,
  "iban": "IR120570028870010164111101",
  "bankName": "پاسارگاد",
  "maritalStatus": "MARRIED",
  "insuranceNumber": "1234567890",
  "insuranceType": "MANDATORY",
  "employmentType": "FULL_TIME",
  "jobTitle": "جوشکار درجه ۲",
  "fatherName": "حسین",
  "idCardNumber": "1234",
  "issuePlace": "تهران",
  "militaryStatus": "COMPLETED",
  "educationLevel": "DIPLOMA",
  "address": "تهران، نازی‌آباد",
  "emergencyContactName": "فاطمه محمدی",
  "emergencyContactPhone": "09129876543"
}

> {%
    client.global.set("emp1Id", response.body.id);
    client.global.set("emp1Code", response.body.personnelCode);
    client.test("کارمند ساخته شد", () => client.assert(response.status === 201));
    client.test("کد پرسنلی تولید شد", () =>
        client.assert(response.body.personnelCode.startsWith("EMP-")));
%}

