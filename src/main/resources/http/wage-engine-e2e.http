### Global variables
### به تنظیمات run configurations تو IntelliJ بگو environment name = dev
### یا از منوی HTTP client، Environment file بساز.

@baseUrl = http://localhost:8080
@contentType = application/json

### ─────────────────────────────────────────────────────────────
### 1. Login as admin (super admin)
### ─────────────────────────────────────────────────────────────
POST {{baseUrl}}/api/v1/auth/login
Content-Type: {{contentType}}

{
  "usernameOrEmail": "admin",
  "password": "ChangeMe@123"
}

> {%
  client.log("Response body: " + JSON.stringify(response.body));
  client.log("accessToken field: " + response.body.accessToken);
  client.global.set("adminAccessToken", response.body.accessToken);
%}
### ─────────────────────────────────────────────────────────────
### 2. (Prerequisite) create a tenant via SUPER_ADMIN
### توجه: چون tenant management هنوز endpoint نداره،
### فرض کن یک tenant با id=1 از قبل seed شده (Platform).
### اگه لازم داری کاربر tenant-scoped بسازی، دستی از DB انجام بده.
### برای این تست، از یک کاربر tenant-scoped با tenantId=1 استفاده می‌کنیم.
### ─────────────────────────────────────────────────────────────

### 2a. Login as tenant user
### ⚠️ این کاربر باید از قبل تو DB وجود داشته باشه با tenantId=1
### و roles شامل: PROJECT_READ, PROJECT_WRITE, EMPLOYEE_READ, EMPLOYEE_WRITE, EMPLOYEE_DELETE,
###                CONTRACT_READ, CONTRACT_WRITE

POST {{baseUrl}}/api/v1/auth/login
Content-Type: {{contentType}}

{
  "usernameOrEmail": "tenant_admin",
  "password": "ChangeMe@123"
}

> {%
    client.test("Tenant login 200", () => {
        client.assert(response.status === 200, "Login failed. status=" + response.status);
        client.assert(response.body.accessToken != null, "No accessToken in response");
    });
    client.global.set("accessToken", response.body.accessToken);
%}

### ─────────────────────────────────────────────────────────────
### 3. Create Project
### ─────────────────────────────────────────────────────────────
POST {{baseUrl}}/api/v1/projects
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "پروژه تست E2E",
  "code": "TEST-E2E-001",
  "description": "برای تست کامل جریان"
}

> {%
    client.test("Project created", () => {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
        client.assert(response.body.id != null, "Project id must be set");
        client.assert(response.body.code === "TEST-E2E-001", "Code mismatch");
        client.assert(response.body.active === true, "Project should be active");
    });
    client.global.set("projectId", response.body.id);
%}

### ─────────────────────────────────────────────────────────────
### 4. Duplicate project code → 409
### ─────────────────────────────────────────────────────────────
POST {{baseUrl}}/api/v1/projects
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "name": "دوباره",
  "code": "TEST-E2E-001"
}

> {%
    client.test("Duplicate code → 409", () => {
        client.assert(response.status === 409, "Expected 409, got " + response.status);
        client.assert(response.body.code === "project.code.duplicate", "Wrong error code");
    });
%}

### ─────────────────────────────────────────────────────────────
### 5. Create Employee
### ─────────────────────────────────────────────────────────────
POST {{baseUrl}}/api/v1/employees
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "firstName": "علی",
  "lastName": "تست",
  "nationalId": "0499370899",
  "birthDate": "1370-05-12",
  "hireDate": "1404-01-15",
  "phoneNumber": "09121234567",
  "email": "ali.test@example.com",
  "childrenCount": 1,
  "iban": "IR820540102680020817909002"
}

> {%
    client.test("Employee created", () => {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
        client.assert(response.body.personnelCode != null, "personnelCode must be auto-generated");
        client.assert(response.body.personnelCode.startsWith("EMP-"), "Wrong personnelCode format");
        client.assert(response.body.active === true, "Employee should be active");
    });
    client.global.set("employeeId", response.body.id);
    client.global.set("personnelCode", response.body.personnelCode);
%}

### ─────────────────────────────────────────────────────────────
### 6. Create Contract
### ─────────────────────────────────────────────────────────────
POST {{baseUrl}}/api/v1/contracts
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "employeeId": {{employeeId}},
  "projectId": {{projectId}},
  "baseSalary": 100000000,
  "housingAllowance": 9000000,
  "foodAllowance": 14000000,
  "childAllowanceBase": 5000000,
  "currency": "IRR",
  "startDate": "1404-01-01",
  "endDate": null,
  "notes": "قرارداد اولیه"
}

> {%
    client.test("Contract created", () => {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
        client.assert(response.body.contractNumber.startsWith("CT-"), "Wrong contract number format");
        client.assert(response.body.voided === false, "Contract should not be voided");
    });
    client.global.set("contractId", response.body.id);
    client.global.set("contractNumber", response.body.contractNumber);
%}

### ─────────────────────────────────────────────────────────────
### 7. Overlap check — same employee + project → 409
### ─────────────────────────────────────────────────────────────
POST {{baseUrl}}/api/v1/contracts
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "employeeId": {{employeeId}},
  "projectId": {{projectId}},
  "baseSalary": 120000000,
  "startDate": "1404-06-01"
}

> {%
    client.test("Overlap → 409", () => {
        client.assert(response.status === 409, "Expected 409, got " + response.status);
        client.assert(response.body.code === "contract.overlap", "Wrong error code");
    });
%}

### ─────────────────────────────────────────────────────────────
### 8. Try to archive project → 409 (has active contract)
### ─────────────────────────────────────────────────────────────
POST {{baseUrl}}/api/v1/projects/{{projectId}}/archive
Authorization: Bearer {{accessToken}}

> {%
    client.test("Archive blocked → 409", () => {
        client.assert(response.status === 409, "Expected 409, got " + response.status);
        client.assert(response.body.code === "project.archive.has_active_contracts", "Wrong error code");
    });
%}

### ─────────────────────────────────────────────────────────────
### 9. Try to delete employee → 409 (has active contract)
### ─────────────────────────────────────────────────────────────
DELETE {{baseUrl}}/api/v1/employees/{{employeeId}}
Authorization: Bearer {{accessToken}}

> {%
    client.test("Delete employee blocked → 409", () => {
        client.assert(response.status === 409, "Expected 409, got " + response.status);
        client.assert(response.body.code === "employee.delete.has_active_contracts", "Wrong error code");
    });
%}

### ─────────────────────────────────────────────────────────────
### 10. End the contract
### ─────────────────────────────────────────────────────────────
POST {{baseUrl}}/api/v1/contracts/{{contractId}}/end
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "endDate": "1404-06-31"
}

> {%
    client.test("Contract ended → 204", () => {
        client.assert(response.status === 204, "Expected 204, got " + response.status);
    });
%}

### ─────────────────────────────────────────────────────────────
### 11. Create replacement contract with previousContractId
### ─────────────────────────────────────────────────────────────
POST {{baseUrl}}/api/v1/contracts
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "employeeId": {{employeeId}},
  "projectId": {{projectId}},
  "baseSalary": 130000000,
  "housingAllowance": 10000000,
  "foodAllowance": 14000000,
  "startDate": "1404-07-01",
  "previousContractId": {{contractId}},
  "notes": "افزایش حقوق سالانه"
}

> {%
    client.test("Replacement contract created", () => {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
        client.assert(response.body.previousContractId != null, "previousContractId must be set");
    });
    client.global.set("contract2Id", response.body.id);
%}

### ─────────────────────────────────────────────────────────────
### 12. Try to reuse the same previousContractId → 409
### ─────────────────────────────────────────────────────────────
POST {{baseUrl}}/api/v1/contracts
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "employeeId": {{employeeId}},
  "projectId": {{projectId}},
  "baseSalary": 150000000,
  "startDate": "1404-10-01",
  "previousContractId": {{contractId}}
}

> {%
    client.test("Duplicate previousContractId → 409", () => {
        client.assert(response.status === 409, "Expected 409, got " + response.status);
        client.assert(response.body.code === "contract.previous.already_linked", "Wrong error code");
    });
%}

### ─────────────────────────────────────────────────────────────
### 13. Void the replacement contract
### ─────────────────────────────────────────────────────────────
POST {{baseUrl}}/api/v1/contracts/{{contract2Id}}/void
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "reason": "اشتباه در ثبت مبلغ"
}

> {%
    client.test("Contract voided → 204", () => {
        client.assert(response.status === 204, "Expected 204, got " + response.status);
    });
%}

### ─────────────────────────────────────────────────────────────
### 14. Now employee has no active contract → delete succeeds
### ─────────────────────────────────────────────────────────────
DELETE {{baseUrl}}/api/v1/employees/{{employeeId}}
Authorization: Bearer {{accessToken}}

> {%
    client.test("Employee soft-deleted → 204", () => {
        client.assert(response.status === 204, "Expected 204, got " + response.status);
    });
%}

### ─────────────────────────────────────────────────────────────
### 15. Employee is now gone from queries
### ─────────────────────────────────────────────────────────────
GET {{baseUrl}}/api/v1/employees/{{employeeId}}
Authorization: Bearer {{accessToken}}

> {%
    client.test("Deleted employee → 404", () => {
        client.assert(response.status === 404, "Expected 404, got " + response.status);
    });
%}

### ─────────────────────────────────────────────────────────────
### 16. Project can be archived now
### ─────────────────────────────────────────────────────────────
POST {{baseUrl}}/api/v1/projects/{{projectId}}/archive
Authorization: Bearer {{accessToken}}

> {%
    client.test("Project archived → 204", () => {
        client.assert(response.status === 204, "Expected 204, got " + response.status);
    });
%}

### ─────────────────────────────────────────────────────────────
### 17. List contracts of (deleted) employee — data still exists
### ─────────────────────────────────────────────────────────────
### توجه: چون employee soft-deleted شده، این endpoint 404 برمی‌گردونه
### چون خودش employee رو چک می‌کنه و find نمی‌کنه.
### این consistent با @SQLRestriction هست.
GET {{baseUrl}}/api/v1/employees/{{employeeId}}/contracts
Authorization: Bearer {{accessToken}}

> {%
    client.test("Employee not found via active query → 404", () => {
        client.assert(response.status === 404, "Expected 404, got " + response.status);
    });
%}